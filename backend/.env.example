# =========================================================
# KasRT Backend — wajib
# =========================================================
NODE_ENV=production
PORT=3005
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK
JWT_EXPIRES_IN=7d
DEFAULT_USER_PIN=123456

# =========================================================
# Backend dan frontend — wajib untuk deployment publik
# =========================================================
CORS_ORIGINS=https://YOUR_FRONTEND.vercel.app
FRONTEND_BASE_URL=https://YOUR_FRONTEND.vercel.app
BACKEND_PUBLIC_URL=https://api-kasrt.example.com

# =========================================================
# Cron reminder Jimpitan — wajib jika Vercel Cron dipakai
# Nilai CRON_SECRET harus sama dengan frontend.
# =========================================================
CRON_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_16_KARAKTER

# =========================================================
# WA Gateway — wajib jika fitur WA dipakai
# WA_LAB_SECRET harus sama persis dengan env gateway.
# Pengaturan reminder, penerima, limit harian, dan JID grup
# dikelola dari /management/whatsapp, bukan dari env backend.
# =========================================================
WA_LAB_BASE_URL=https://wa-kasrt.example.com
WA_LAB_SECRET=

# Alias kompatibilitas lama (opsional; gunakan WA_LAB_BASE_URL sebagai pilihan utama).
# WA_GATEWAY_BASE_URL=https://wa-kasrt.example.com
# WA_GATEWAY_URL=https://wa-kasrt.example.com/send

# =========================================================
# Telegram — opsional, wajib hanya jika notifikasi Telegram dipakai
# =========================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# =========================================================
# Redis — opsional; backend fallback tanpa cache jika kosong
# =========================================================
REDIS_URL=

# =========================================================
# Konfigurasi aplikasi tambahan — opsional
# =========================================================
LINGKUNGAN_TARGET_BULANAN=
DEBUG_JIMPITAN=false

# Alias URL opsional untuk link approval/notifikasi lama.
# FRONTEND_URL=https://YOUR_FRONTEND.vercel.app
# APP_BASE_URL=https://YOUR_FRONTEND.vercel.app
# NEXT_PUBLIC_APP_URL=https://YOUR_FRONTEND.vercel.app
