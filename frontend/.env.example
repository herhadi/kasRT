# =========================================================
# Frontend KasRT — Vercel
# =========================================================
# URL publik backend API di Debian/Cloudflare Tunnel.
# NEXT_PUBLIC_* ikut masuk ke browser, jadi jangan isi secret di sini.
NEXT_PUBLIC_API_URL=https://api-kasrt.example.com

# URL backend untuk route server-side/cron frontend.
# Gunakan URL yang sama dengan NEXT_PUBLIC_API_URL.
API_URL=https://api-kasrt.example.com

# Secret untuk meneruskan cron dari Vercel ke backend.
# Harus sama persis dengan CRON_SECRET pada backend Debian.
CRON_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_16_KARAKTER

# Opsional: URL publik frontend untuk metadata/PWA.
NEXT_PUBLIC_APP_URL=https://YOUR_APP.vercel.app
