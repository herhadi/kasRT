PORT=3010
WA_LAB_SECRET=ganti_dengan_secret_panjang
WA_AUTH_DIR=./auth
WA_DATA_DIR=./data
WA_LOG_LEVEL=silent

# Batas uji coba manual. Jangan naikkan dulu saat warmup.
WA_LAB_DAILY_UNIQUE_LIMIT=3
WA_LAB_MIN_TEXT_LENGTH=2

# baileys-antiban conservative defaults
WA_ANTIBAN_PRESET=conservative
WA_ANTIBAN_MAX_PER_MINUTE=1
WA_ANTIBAN_MAX_PER_HOUR=5
WA_ANTIBAN_MAX_PER_DAY=10
WA_ANTIBAN_MIN_DELAY_MS=90000
WA_ANTIBAN_MAX_DELAY_MS=300000
WA_ANTIBAN_WARMUP_DAYS=7
WA_ANTIBAN_LOGGING=true
